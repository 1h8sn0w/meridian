{
  "name": "meridian",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "bootstrap": "node infra/bootstrap.mjs",
    "dev": "pnpm --filter @meridian/core build && pnpm --filter @meridian/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --filter @meridian/core build && pnpm --recursive typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @meridian/db migrate",
    "test": "node --test tests/*.test.mjs && pnpm --recursive --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  }
}
