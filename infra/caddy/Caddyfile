{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	default_sni {$APP_HOST:localhost}
}

{$APP_URL:http://localhost} {
	encode zstd gzip

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle_path /sync/* {
		reverse_proxy powersync:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		templates
		try_files {path} /index.html
		file_server
	}
}
