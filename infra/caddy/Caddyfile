# Єдиний вхід у стек. Одне походження, чотири маршрути — і жодного порту в
# браузері.
#
# Адреса сайту приходить зі змінної APP_URL (див. compose.yaml). Схема в ній
# значуща для Caddy:
#   http://localhost              — простий HTTP, без сертифікатів;
#   https://meridian.example.com  — Caddy сам візьме сертифікат Let's Encrypt.
# Типове значення — http://localhost, тому локально браузер не лається на
# невідомий центр сертифікації: сертифіката просто немає, і він не потрібен.
#
# Синтаксис {$VAR:default} — офіційний Caddyfile, підстановка відбувається до
# парсингу конфігу.

{$APP_URL:http://localhost} {
	encode zstd gzip

	# handle_path — саме він зрізає префікс: сервіси нижче нічого не знають про
	# те, під яким шляхом їх видно ззовні, і працюють як у власному корені.

	# GoTrue. Шлях /auth/v1 — той самий, що в офіційному Supabase (там його
	# роздає kong), тому supabase-js працює без налаштувань.
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	# PostgREST.
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	# PowerSync. Потік синхронізації довгоживучий і поступовий: flush_interval
	# -1 вимикає буферизацію відповіді й віддає дані одразу після кожного
	# запису. Апгрейд до WebSocket Caddy проксіює сам.
	handle_path /sync/* {
		reverse_proxy powersync:8080 {
			flush_interval -1
		}
	}

	# Усе інше — сам застосунок.
	handle {
		reverse_proxy web:3000
	}
}
