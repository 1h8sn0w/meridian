{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	default_sni {$APP_HOST:localhost}
}

{$APP_URL:http://localhost} {
	encode zstd gzip
	root * /srv

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle_path /sync/* {
		reverse_proxy powersync:8080 {
			flush_interval -1
		}
	}

	handle /env.js {
		templates {
			mime text/javascript application/javascript
		}
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
