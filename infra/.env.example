# Контракт змінних середовища V2. Значення — порожні: реальні живуть лише
# в infra/.env, який у git не потрапляє. Заповнення й перевірка — MER-43.

# --- Supabase (з офіційного .env самого Supabase) ---
POSTGRES_PASSWORD=
JWT_SECRET=          # 32+ символи
ANON_KEY=
SERVICE_ROLE_KEY=

# --- PowerSync ---
PS_DATABASE_URI=     # Postgres-рядок інстансу Supabase, куди дивиться PowerSync
PS_JWKS_URL=         # JWKS-ендпоінт Supabase GoTrue: ним PowerSync перевіряє JWT клієнтів
POWERSYNC_URL=       # внутрішня адреса сервісу для застосунку

# --- Публічні адреси для браузера ---
PUBLIC_SUPABASE_URL=
PUBLIC_POWERSYNC_URL=

# --- Міграції ---
# Postgres-рядок для drizzle-kit (`pnpm db:migrate`). Поза контрактом із
# документа V2 — доданий у MER-42, бо drizzle-kit читає саме змінну середовища.
# Звірити з MER-43/MER-44: можливо, зіллється з PS_DATABASE_URI.
DATABASE_URL=
