# Контракт змінних середовища V2 для НАШОГО compose (infra/docker-compose.yml).
# Скопіювати в infra/.env і заповнити. Секретні значення тут порожні й такими
# лишаються: реальні живуть лише в infra/.env, який у git не потрапляє.
#
# Supabase має власний .env у своєму каталозі (див. infra/README.md). Значення
# нижче мають збігатися з ним там, де це позначено.

# --- Supabase (з офіційного .env самого Supabase) ---
# Пароль Postgres — той самий, що в .env Supabase.
POSTGRES_PASSWORD=
# 32+ символи. Потрібен лише якщо проєкт лишився на легасі-ключах HS256.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Ім'я мережі офіційного compose Supabase. У нього `name: supabase`, тому
# мережа за замовчуванням — supabase_default. Міняти лише якщо змінено name.
SUPABASE_NETWORK=supabase_default

# --- PowerSync ---
# Джерело реплікації. Хост `supabase-db` — це container_name сервісу `db`
# офіційного compose. Підключення пряме, порт 5432 усередині мережі — НЕ через
# пулер supavisor: логічна реплікація потребує прямого з'єднання.
PS_DATABASE_URI=postgresql://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/postgres

# Сховище бакетів синхронізації. Postgres замість MongoDB — щоб не тягнути
# окремий рушій БД (обґрунтування — в infra/powersync/service.yaml).
# Поза початковим контрактом із документа V2: змінна з'явилась разом із цим
# вибором. Схему в указаній базі PowerSync створює сам.
PS_STORAGE_URI=postgresql://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/postgres

# JWKS-ендпоінт Supabase GoTrue: ним PowerSync перевіряє JWT клієнтів.
# `kong` — мережевий контейнер Supabase, 8000 — його внутрішній порт.
PS_JWKS_URL=http://kong:8000/auth/v1/.well-known/jwks.json

# Порт API PowerSync (усередині мережі й на петлі хоста).
PS_PORT=8080

# Внутрішня адреса сервісу для застосунку.
POWERSYNC_URL=http://powersync:8080

# --- Застосунок ---
WEB_PORT=3000

# --- Публічні адреси для браузера ---
# Supabase віддається власним kong'ом; наш Caddy його не проксіює — в інструкції
# V2 рівно два імені хостів.
PUBLIC_SUPABASE_URL=http://localhost:8000
# Локально — порт PowerSync на петлі. Через Caddy це буде https://${SYNC_HOST}.
PUBLIC_POWERSYNC_URL=http://localhost:8080

# --- Caddy ---
# Локально Caddy видає сертифікати власним внутрішнім CA. Для реального домену
# просто підставити його сюди — ACME спрацює автоматично.
APP_HOST=localhost
SYNC_HOST=sync.localhost

# --- Міграції ---
# Postgres-рядок для drizzle-kit (`pnpm db:migrate`). Поза контрактом із
# документа V2 — доданий у MER-42, бо drizzle-kit читає саме змінну середовища.
# Запускається з ХОСТА, тому адреса хостова: supavisor публікує Postgres
# на 5432 у session-режимі. З PS_DATABASE_URI не зливається — різні мережі.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres
