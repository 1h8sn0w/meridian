{
  // Збірка пакета: те саме, що `tsconfig.json`, але без юніт-тестів — вони
  // живуть поруч із кодом (`src/**/*.test.ts`), проте в `dist` їм не місце.
  // Перевірку типів і лінт тести проходять на загальних підставах.
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts", "src/test-support.ts"],
  "compilerOptions": {
    // Домен не має залежати від середовища виконання: у зібраному пакеті
    // глобалей Node немає — він так само їде в браузер і в Capacitor.
    "types": []
  }
}
