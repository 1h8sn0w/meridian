# Цей файл потрібен лише тим, хто хоче щось змінити.
#
# `docker compose up` працює без нього: усе нижче має робочі типові значення, а
# секрети (пароль Postgres, JWT_SECRET, anon-ключ) стек генерує собі сам при
# першому запуску й тримає у власному томі. Тут секретів немає й бути не має.
#
# Щоб щось перевизначити: `cp .env.example .env` і правити. `.env` у git не
# потрапляє.

# --- Адреса, за якою відкривають застосунок ---
# Єдина змінна, яку варто задати, і лише якщо стек виходить в інтернет. Схема
# значуща: `https://` вмикає автоматичний сертифікат Let's Encrypt (потрібно,
# щоб домен резолвився на цей хост, а 80/443 доходили ззовні).
#
#   APP_URL=https://meridian.example.com
#
# З неї збирається все: сайт у Caddy, адреси для браузера й посилання GoTrue.
APP_URL=http://localhost

# --- Порти хоста ---
# Міняти лише в разі конфлікту: 80/443 на хості може вже слухати щось інше.
# Caddy слухає ці самі порти й усередині контейнера, тож порт у APP_URL має
# збігатися з одним із них (напр. HTTP_PORT=8080 і http://localhost:8080).
# Домашній сервер без домену — https://<IP>:<HTTPS_PORT>: infra/README.md,
# «Домашній сервер без домену».
HTTP_PORT=80
HTTPS_PORT=443

# --- Реєстрація ---
# Типово ВІДКРИТА, і типове значення таким лишається свідомо: інакше свіжий
# `docker compose up` не дав би завести навіть перший акаунт. Але щойно стек
# видно з інтернету, це означає «зареєструватись може будь-хто», тож закрити
# реєстрацію — останній крок установки, а не порада наостанок:
#
#   GOTRUE_DISABLE_SIGNUP=true
#
# Далі `docker compose up -d auth`. Входити тим, у кого акаунт уже є, це не
# заважає, зате нового члена сім'ї так не додати (щоб прийняти код запрошення,
# акаунт треба вже мати), а відновлення пароля не працює й при відкритій —
# пошти в стеку немає. Порядок дій — infra/README.md, «Свій домен».
#
# Через ту саму відсутність пошти акаунт підтверджується автоматично: лист із
# підтвердженням нікуди б не пішов і ввійти було б неможливо. Лікує лише SMTP
# (змінні GOTRUE_SMTP_* в compose.yaml) — тоді ж варто вимкнути й
# автопідтвердження.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false

# --- За тунелем (Cloudflare Tunnel) ---
# Типово Caddy слухає адресу з APP_URL: з `https://домен` сам бере сертифікат
# Let's Encrypt. За тунелем TLS закінчується в Cloudflare, і Let's Encrypt до
# Caddy не достукається. Тоді APP_URL лишається `https://домен`, а Caddy
# слухає простий HTTP на HTTP_PORT, куди й веде тунель:
#
#   SITE_ADDRESS=http://
#
# Порожньо — адреса з APP_URL. Після зміни: `docker compose up -d caddy`.
SITE_ADDRESS=

# --- Ліміт спроб входу за проксі чи тунелем ---
# GoTrue обмежує спроби входу з однієї адреси (заголовок X-Real-IP ставить
# Caddy). Якщо до Caddy ходять не люди напряму, а проксі чи тунель (Cloudflare
# Tunnel, nginx), Caddy бачить лише адресу проксі, і ліміт стає один на всіх:
# чужий перебір паролів зупинить вхід і вам. Тоді задайте, з яких адрес
# ходить проксі, і заголовок, у якому він передає справжню адресу:
#
#   TRUSTED_PROXIES=172.16.0.0/12
#   CLIENT_IP_HEADER=Cf-Connecting-IP
#
# Cloudflare Tunnel — Cf-Connecting-IP, nginx — X-Forwarded-For. Адреса
# проксі — та, з якої він приходить до Caddy: для cloudflared у Docker — його
# підмережа (`docker network inspect`). Кілька — через пробіл. Не вписуйте
# адреси, з яких ходять самі люди: заголовок від довіреної адреси Caddy бере на
# віру. Після зміни: `docker compose up -d caddy`.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=X-Forwarded-For

# --- Вхід через Google, Discord і GitHub ---
# Типово вимкнено: на екрані входу лише пошта й пароль. Кнопка провайдера
# з'являється сама, щойно його ввімкнено тут (застосунок питає GoTrue,
# /auth/v1/settings). Після зміни: `docker compose up -d auth`.
#
# Секретів у репозиторії немає: кожна установка реєструє власний
# OAuth-застосунок у провайдера й вписує сюди його Client ID і секрет.
# Адреса повернення (redirect / callback URL), яку вказати провайдеру, —
# APP_URL + /auth/v1/callback, напр.
#
#   https://meridian.example.com/auth/v1/callback
#
# compose.yaml збирає її з APP_URL сам. Де зареєструвати:
#
#   Google  — Google Cloud Console → APIs & Services → Credentials →
#             Create credentials → OAuth client ID, тип «Web application»;
#             адреса — в «Authorized redirect URIs».
#   Discord — Developer Portal → Applications → New Application → OAuth2:
#             Client ID, Reset Secret; адреса — в «Redirects».
#   GitHub  — Settings → Developer settings → OAuth Apps → New OAuth App;
#             адреса — в «Authorization callback URL».
#
# Адреса з IP (https://192.168.1.10:8443): Google такої не приймає — лише
# https і домен із публічним суфіксом (виняток — localhost), тож для нього
# потрібен домен. Документація GitHub і Discord IP не забороняє, але на живій
# реєстрації це не перевірено. Discord може не віддати пошту (людина зняла
# дозвіл `email`) — тоді акаунт без пошти, застосунок це переживає.
#
#   GOTRUE_EXTERNAL_GITHUB_ENABLED=true
#   GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=...
#   GOTRUE_EXTERNAL_GITHUB_SECRET=...
#
# Так само GOTRUE_EXTERNAL_GOOGLE_* і GOTRUE_EXTERNAL_DISCORD_*.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_ENABLED=false

# Прив'язка до наявного акаунта. Хто вже має акаунт (пошта з паролем чи один
# із провайдерів), прив'язує інші на екрані «Сім'я» → «Способи входу» і далі
# входить будь-яким у той самий акаунт і ту саму сім'ю. Відв'язати можна все,
# крім пошти й останнього способу входу.
#
# Автоматичної прив'язки за поштою немає. GoTrue вміє сам приєднати вхід через
# провайдера до акаунта з тією самою поштою, але при
# GOTRUE_MAILER_AUTOCONFIRM=true (типово, бо пошти в стеку немає) він вважає
# підтвердженою будь-яку пошту від провайдера, а GitHub віддає й
# непідтверджені. Тоді чужий акаунт GitHub із вашою адресою відкрив би ваш
# акаунт. Тому кожен провайдер — окремий домен прив'язки: перший вхід через
# нього без ручної прив'язки створює НОВИЙ акаунт, навіть із тією самою
# поштою (такий акаунт не може задати пароль чи змінити пошту).
#
# Конфлікт: прив'язка відповідає «уже прив'язаний до іншого користувача», якщо
# цим акаунтом провайдера вже входили окремо. Злити два акаунти застосунок не
# вміє. Якщо другий акаунт ще без сім'ї, адміністратор видаляє його
# (docker compose exec db psql -U postgres, таблиця auth.users) — після цього
# прив'язка проходить.
#
# Повернути автоматичну прив'язку (лише з SMTP і
# GOTRUE_MAILER_AUTOCONFIRM=false):
#
#   GOTRUE_EXPERIMENTAL_PROVIDERS_WITH_OWN_LINKING_DOMAIN=

# --- Відлік до запуску ---
# Порожньо — застосунок як завжди. Мить у майбутньому — відвідувач без входу
# бачить замість екрана входу відлік до неї; вхід лишається за адресою
# APP_URL + /login (її дають тим, хто вже має доступ). Це не захист: від чужих
# акаунтів захищає закрита реєстрація вище. Щойно мить настає, відлік зникає
# сам, без перезапуску. Формат — дата з часом і зсувом від UTC, напр.
#
#   RELEASE_AT=2026-12-10T10:00:00+02:00
#
# Сама дата (2026-12-10) — північ за UTC. Інший формат ігнорується. Після
# зміни: `docker compose up -d caddy`.
RELEASE_AT=

# --- Готові образи стека ---
# Порожньо — образи застосунку (Caddy зі статичною збіркою), GoTrue, Postgres,
# PowerSync і init збираються з вихідників, кілька хвилин на перший раз. Якщо
# образи вже опубліковано, накладка infra/compose.prebuilt.yaml підставить їх
# замість збірки: IMAGE_NAMESPACE — власник образів на Docker Hub, IMAGE_TAG —
# тег (порожньо — staging), WEB_IMAGE — образ застосунку, якщо він лежить
# деінде. Див. infra/README.md, «Готовий образ».
IMAGE_NAMESPACE=
IMAGE_TAG=
WEB_IMAGE=

# --- Стартовий набір страв (MER-77) ---
# Порожньо — набору немає, і застосунок працює як без нього. Шлях до JSON-файлу
# на хості (відносний — від compose.yaml), напр.:
#
#   STARTER_SET_FILE=/srv/meridian/starter-set.json
#
# Файл тримати ПОЗА репозиторієм: це персональні плани дієтолога. Формат —
# packages/core/README.md, перевірка — `pnpm starter:check <файл>`. Після зміни
# файлу або змінної: `docker compose up migrate`. Деталі — infra/README.md.
STARTER_SET_FILE=
