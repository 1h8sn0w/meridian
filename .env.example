# Цей файл потрібен лише тим, хто хоче щось змінити.
#
# `docker compose up` працює без нього: усе нижче має робочі типові значення, а
# секрети (пароль Postgres, JWT_SECRET, anon-ключ) стек генерує собі сам при
# першому запуску й тримає у власному томі. Тут секретів немає й бути не має.
#
# Щоб щось перевизначити: `cp .env.example .env` і правити. `.env` у git не
# потрапляє.

# --- Адреса, за якою відкривають застосунок ---
# Єдина змінна, яку варто задати, і лише якщо стек виходить в інтернет. Схема
# значуща: `https://` вмикає автоматичний сертифікат Let's Encrypt (потрібно,
# щоб домен резолвився на цей хост, а 80/443 доходили ззовні).
#
#   APP_URL=https://meridian.example.com
#
# З неї збирається все: сайт у Caddy, адреси для браузера й посилання GoTrue.
APP_URL=http://localhost

# --- Порти хоста ---
# Міняти лише в разі конфлікту: 80/443 на хості може вже слухати щось інше.
# Всередині стека порти не змінюються, тож APP_URL із нетиповим портом треба
# вказати повністю (напр. http://localhost:8080).
HTTP_PORT=80
HTTPS_PORT=443

# --- Реєстрація ---
# Типово ВІДКРИТА, і типове значення таким лишається свідомо: інакше свіжий
# `docker compose up` не дав би завести навіть перший акаунт. Але щойно стек
# видно з інтернету, це означає «зареєструватись може будь-хто», тож закрити
# реєстрацію — останній крок установки, а не порада наостанок:
#
#   GOTRUE_DISABLE_SIGNUP=true
#
# Далі `docker compose up -d auth`. Входити тим, у кого акаунт уже є, це не
# заважає, зате нового члена сім'ї так не додати (щоб прийняти код запрошення,
# акаунт треба вже мати), а відновлення пароля не працює й при відкритій —
# пошти в стеку немає. Порядок дій — infra/README.md, «Свій домен».
#
# Через ту саму відсутність пошти акаунт підтверджується автоматично: лист із
# підтвердженням нікуди б не пішов і ввійти було б неможливо. Лікує лише SMTP
# (змінні GOTRUE_SMTP_* в compose.yaml) — тоді ж варто вимкнути й
# автопідтвердження.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false

# --- Готовий образ застосунку ---
# Порожньо — `web` збирається з вихідників (кілька хвилин на перший раз). Якщо
# образ уже опубліковано, накладка infra/compose.prebuilt.yaml підставить його
# замість збірки: див. infra/README.md, «Готовий образ».
WEB_IMAGE=
