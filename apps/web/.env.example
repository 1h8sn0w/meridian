# Конфіг для `pnpm dev` — тільки для розробки застосунку.
#
# Самому self-host цей файл не потрібен: у стеку сервіс `web` дістає ті самі
# значення рантаймом із compose.yaml і згенерованих секретів, нічого копіювати
# не треба. Тут вони потрібні тому, що `pnpm dev` — це Vite поза стеком, і
# змінні він підставляє на етапі збірки.
#
# Готовий файл робиться однією командою з уже піднятого стека (anon-ключ
# генерується всередині нього, тож вписувати його руками нема звідки):
#
#   docker compose exec -T web sh -c '. /secrets/app.env; printf "PUBLIC_SUPABASE_URL=%s\nPUBLIC_SUPABASE_ANON_KEY=%s\nPUBLIC_POWERSYNC_URL=%s/sync\n" "$PUBLIC_SUPABASE_URL" "$ANON_KEY" "$PUBLIC_SUPABASE_URL"' > apps/web/.env

# Походження стека — те саме, що відкриває браузер. Порту немає навмисно:
# Caddy роздає auth, rest і sync шляхами під одним іменем хоста.
PUBLIC_SUPABASE_URL=http://localhost

# Anon-ключ стека. Не секрет: він і створений для того, щоб лежати у браузері,
# а доступ обмежують RLS-політики (MER-44). Значення — з /secrets/app.env
# усередині стека, командою вище.
PUBLIC_SUPABASE_ANON_KEY=

# Адреса sync-сервісу для браузера (MER-46) — той самий хост, шлях /sync.
# Порожньо — застосунок працює, але лишається на одному пристрої й прямо про це
# каже на екрані сім'ї.
PUBLIC_POWERSYNC_URL=http://localhost/sync
