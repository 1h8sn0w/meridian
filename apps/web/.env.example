# Конфіг для `pnpm dev` (MER-45). Скопіювати в apps/web/.env.
#
# Ті самі імена, що в контракті infra/.env.example — щоб одне значення не мало
# двох назв. У продакшні ці змінні приходять рантаймом (сервіс `web` у
# infra/docker-compose.yml), тут — на етапі збірки, через Vite.

# Адреса Supabase, якою ходить БРАУЗЕР. Для локального self-host це kong.
PUBLIC_SUPABASE_URL=http://localhost:8000

# Значення ANON_KEY із .env самого Supabase. Не секрет: ключ і створений для
# того, щоб лежати у браузері, а доступ обмежують RLS-політики (MER-44).
PUBLIC_SUPABASE_ANON_KEY=

# Адреса sync-сервісу PowerSync, якою ходить БРАУЗЕР (MER-46). Локально це порт
# 8080 на петлі — так його публікує infra/docker-compose.yml. Через Caddy на
# реальному хості це буде https://${SYNC_HOST}.
#
# Порожньо — застосунок працює, але лишається на одному пристрої й прямо про це
# каже на екрані сім'ї.
PUBLIC_POWERSYNC_URL=http://localhost:8080
